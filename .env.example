# EJC Environment Configuration

# Application
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000/api
WEB_URL=http://localhost:5173

# Database (PostgreSQL with pgvector)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ejc_db?schema=public"

# Redis Cache & Background Jobs
REDIS_URL="redis://localhost:6379"

# JWT Authentication
JWT_SECRET="ejc-enterprise-jwt-super-secret-key-32-chars-min"
JWT_REFRESH_SECRET="ejc-enterprise-jwt-refresh-super-secret-key-min"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# AI & LLM Gateway (OpenRouter / OpenAI compatible)
AI_GATEWAY_URL="https://openrouter.ai/api/v1"
AI_API_KEY="your-openrouter-or-openai-api-key"
AI_CHAT_MODEL="google/gemini-2.5-flash"
AI_EMBEDDING_MODEL="text-embedding-3-small"

# Storage (S3 / MinIO compatible)
STORAGE_PROVIDER="local"
S3_BUCKET="ejc-documents"
S3_REGION="us-east-1"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_ENDPOINT=""

# Email (Resend / SendGrid / Mock)
EMAIL_PROVIDER="mock"
EMAIL_API_KEY=""
EMAIL_FROM="EJC System <notifications@ejc.internal>"
